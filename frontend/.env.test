# Test environment variables
NODE_ENV=development
DATABASE_URL=file:./prisma/test.db
DANGER_ENABLE_FAKE_LOGIN_ON_DEV=true
DANGER_FAKE_LOGIN_PASSWORD=test-password

# S3/Minio settings for testing
S3_STORAGE_BUCKET=test-bucket
S3_STORAGE_ACCESS_KEY=test-access-key
S3_STORAGE_SECRET_KEY=test-secret-key
S3_STORAGE_REGION=us-east-1
S3_STORAGE_ENDPOINT=http://localhost:9000
S3_STORAGE_IS_MINIO=true

# Meilisearch settings for testing
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=test-master-key

# Email settings for testing (can be dummy values)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=test@example.com
EMAIL_SMTP_PASSWORD=test-password
EMAIL_USE_STARTTLS=false
EMAIL_FROM_ADDRESS=test@example.com

# Session secret for testing
SESSION_SECRET=test-session-secret-key-for-e2e-tests

# Auth callback base URL
AUTH_CALLBACK_BASE=http://localhost:3000
